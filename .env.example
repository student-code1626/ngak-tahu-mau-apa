# WiseFinance Environment Configuration
# Salin file ini menjadi .env dan sesuaikan dengan konfigurasi Laragon MySQL kamu.

# Database URL MySQL (Laragon Default port 3306, user: root, password: kosong)
# Jika kamu menyetel password di MySQL Laragon, masukkan di antara root:<password>@localhost:3306/wisefinance
DATABASE_URL="mysql://root:@localhost:3306/wisefinance"

# NextAuth Secret & URL
NEXTAUTH_SECRET="wisefinance-super-secret-key-development-32chars-min"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Provider Configuration
# Pilihan: "gemini" | "openai" | "local-rule"
AI_PROVIDER="gemini"
GEMINI_API_KEY=""

# Nilai Tukar / Kurs (Optional ExchangeRate API Key)
EXCHANGERATE_API_KEY=""

